<%= search_form_for @q do |form| %>
  <div style="display: flex; justify-content: flex-end; align-items: center; gap: 10px; width: 100%;">
    
    <div class="field has-addons">
      <div class="control">
        <span class="button is-static">Поиск:</span>
      </div>
      <div class="control">
        <%= form.search_field :title_or_body_cont, class: "input", placeholder: "Найти" %>
      </div>
    </div>

    <div class="control">
      <%= form.submit "Поиск", class: "button is-link" %>
    </div>

  </div>
<% end %>
