<div class="ml-5 mr-5 mt-5">
  <%= form_with url: session_path do |f| %>
    <div class="field">
      <%= f.label "Электронная почта", value: params[:email], class: "label" %>
      
      <div class="control">
	<%= f.text_field :email, class: "input" %>
      </div>
      
    </div>
    <div class="field">
      <%= f.label "Пароль", class: "label" %>
      <div class="control">
	<%= f.password_field :password, class: "input" %>
      </div>
      
    </div>
    <div class="checkbox">
      <%= f.check_box :remember_me, class: "checkbox", value: "1" %>
      <%= f.label "Запомнить мения", class: "checkbox" %>
    </div>
    
    <div class="control">
      <%= f.submit 'Войти', class: 'button is-link' %>
    </div>
    <%= link_to t('session.form.reset_password'), new_password_reset_path, class: "has-text-link" %>
  <% end %>
</div>
